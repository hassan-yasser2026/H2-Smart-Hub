{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "تشغيل كود التطبيق الصحيح",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"0.0.0.0"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build H2 Hub Android",
			"type": "shell",
			"command": ".\\gradlew.bat :app:assembleDebug",
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Smart Hub app",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Smart Hub app on port 3001",
			"type": "shell",
			"command": "$env:PORT = '3001'; $env:GEMINI_API_KEY = 'demo-key'; npm run dev",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Smart Hub dev server",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Smart Hub",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Install Android Debug APK",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				"installDebug"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "TypeScript Check",
			"type": "shell",
			"command": "npm run lint",
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Build Android debug APK",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				"assembleDebug",
				"--stacktrace"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Install Smart Hub on USB device",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				":app:installDebug"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install H2 Smart Hub via USB",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				":app:installDebug"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}